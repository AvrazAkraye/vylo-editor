{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the window is allowed to do. Deliberately small: folder picking, and the three read-only tool commands.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "updater:default",
    "process:allow-restart",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-theme",
    "core:window:allow-start-dragging"
  ]
}
