{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vylo Editor",
  "version": "0.23.0",
  "identifier": "com.vylo.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vylo Editor",
        "width": 1180,
        "height": 800,
        "minWidth": 720,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://chat.vylo-tech.com https://capi.vylo-tech.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Vylo Tech",
    "category": "DeveloperTool",
    "shortDescription": "AI coding agent",
    "longDescription": "An AI coding agent that works on a folder on your own machine, powered by the Vylo Claude gateway.",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://capi.vylo-tech.com/updates/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExQUJGMUJENjZFQ0MxRTYKUldUbXdleG12Zkdyb1dLZTA1cSt2MDBZeFgrMzV5cE9saW9HY2NCTWgwZUxWOHk3RGtBUStJdnAK"
    }
  }
}
